# Copy to .env and fill in. 
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TIMEZONE=Asia/Kolkata

# Option A: TickTick personal API token (or OAuth access token) here
TICKTICK_TOKEN=
# Option B: OAuth. Fill these two, then run: python auth.py
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=

# Optional: a TickTick project/list id. Empty = Inbox.
TICKTICK_PROJECT_ID=
